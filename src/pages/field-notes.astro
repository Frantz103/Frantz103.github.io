---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('field-notes');
const current = notes[0];
const items = current.body ? current.body.split('\n').filter((line: string) => line.startsWith('- ')).map((line: string) => line.slice(2)) : [];
---

<BaseLayout
  title="Field Notes"
  description="A living snapshot of what I am working on and thinking through."
>
  <div class="pt-32 pb-20 px-6">
    <div class="w-full max-w-6xl mx-auto fade-up">
      <div class="mb-10 pl-2">
        <div class="flex items-center gap-3 mb-3">
          <span class="relative flex h-3 w-3">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-indigo-500"></span>
          </span>
          <span class="text-indigo-600 font-bold tracking-widest uppercase text-xs"
            >Field Notes</span
          >
        </div>
        <h2 class="text-5xl md:text-6xl font-serif font-bold text-neutral-900 tracking-tight">
          Field Notes
        </h2>
      </div>

      <div
        class="bg-white rounded-2xl shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)] border border-neutral-100 overflow-hidden"
      >
        <div
          class="px-8 pt-8 pb-6 bg-gradient-to-b from-neutral-50/50 to-white border-b border-neutral-50"
        >
          <p class="text-xl font-serif text-neutral-600 italic leading-relaxed">
            "{current.data.quote}"
          </p>
        </div>

        <div class="p-8 md:p-10">
          <h3
            class="text-sm font-bold text-neutral-400 uppercase tracking-widest mb-6 flex items-center gap-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-indigo-500"
            >
              <path
                d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
              ></path>
              <circle cx="12" cy="13" r="3"></circle>
            </svg>
            {current.data.title}
          </h3>

          <ul class="space-y-6">
            {
              items.map((item: string) => (
                <li class="flex gap-4 group">
                  <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-indigo-200 group-hover:bg-indigo-500 transition-colors flex-shrink-0" />
                  <span class="text-lg text-neutral-700 font-light leading-relaxed">{item}</span>
                </li>
              ))
            }
          </ul>

          <div
            class="mt-10 pt-6 border-t border-dashed border-neutral-200 flex flex-col md:flex-row md:items-center md:justify-between gap-2"
          >
            <span class="text-xs font-medium text-neutral-400 uppercase tracking-wider"
              >Keeping close track of slow practice</span
            >
            <span class="text-xs font-mono text-indigo-500 bg-indigo-50 px-3 py-1 rounded-full"
              >Last updated: {current.data.lastUpdated}</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
