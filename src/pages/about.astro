---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import portrait from '@/assets/homepage.jpg';

const focusAreas = [
  'Cognitive Science',
  'Human Computer Interaction',
  'Machine Perception',
  'Computational Aesthetics',
  'Agent Architecture',
  'Philosophy of Mind',
  'Local AI Systems',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  jobTitle: 'Independent Researcher',
  description:
    'Independent researcher and software developer exploring AI, cognitive science, and computational aesthetics. Builder of AI systems, HuggingFace Spaces, and the CDAA framework.',
  sameAs: [
    'https://www.linkedin.com/in/frantz103/',
    'https://github.com/Frantz103',
    'https://huggingface.co/Frantz103',
    'https://medium.com/@AugustinCaz',
    'https://frantzphotography.com',
    'https://www.threads.com/@augustincaz',
    'https://substack.com/@franzcode',
  ],
};
---

<BaseLayout title="About" description="About Frantz Augustin — independent researcher and developer building AI systems, from agent architectures to accessibility tools." jsonLd={jsonLd}>
  <div class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">
      <div class="order-2 md:order-1 relative">
        <div class="aspect-[3/4] overflow-hidden rounded-sm bg-neutral-100">
          <Image
            src={portrait}
            alt="Frantz Augustin"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out grayscale hover:grayscale-0"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-indigo-50 -z-10 rounded-full blur-2xl"></div>
        <div class="absolute -top-6 -left-6 w-32 h-32 bg-purple-50 -z-10 rounded-full blur-2xl"></div>
      </div>

      <div class="order-1 md:order-2 flex flex-col justify-center h-full">
        <h2 class="text-4xl md:text-6xl font-serif font-bold text-neutral-900 mb-8">
          About Frantz.
        </h2>

        <div class="space-y-6 text-lg text-neutral-600 leading-relaxed font-light">
          <p>
            I am an independent researcher based in San Diego working at the intersection of cognition, computation, and aesthetics. I study how machines learn, how humans make meaning, and where those processes converge in ways that matter.
          </p>

          <p>
            I bring 6.5 years of software development experience across Python, TypeScript, and Ruby on Rails, with academic foundations from Harvard Extension and MIT xPRO programs. My technical background shapes how I approach research — I build the tools I theorize about.
          </p>

          <p>
            My ML journey started with 100 Days of ML and FastAI, where I trained my first image classifiers and deployed them to <a href="https://huggingface.co/Frantz103" target="_blank" rel="noreferrer" class="text-indigo-600 hover:text-indigo-800 underline decoration-indigo-200 hover:decoration-indigo-400 transition-colors">HuggingFace Spaces</a>. From there I moved into multimodal models, built <a href="https://huggingface.co/spaces/Frantz103/CaptionQuest" target="_blank" rel="noreferrer" class="text-indigo-600 hover:text-indigo-800 underline decoration-indigo-200 hover:decoration-indigo-400 transition-colors">CaptionQuest</a> to compare captioning models, and developed the Concept-Driven Agent Architecture (CDAA) — a framework for building AI agents grounded in explicit conceptual reasoning.
          </p>

          <p>
            Right now I'm focused on CDAA development, local model evaluation (testing models like Qwen3-0.6B on structured tasks), computational aesthetics, and preparing for graduate study. I'm particularly interested in how small, local models can serve as cognitive tools rather than replacement systems.
          </p>

          <p>
            I'm looking for co-authors, lab affiliations, and collaborators interested in joint experiments. If you work on agent architectures, machine perception, or computational approaches to meaning — I'd like to hear from you.
          </p>

          <p class="text-base text-neutral-500">
            Find me on <a href="https://huggingface.co/Frantz103" target="_blank" rel="noreferrer" class="text-indigo-600 hover:text-indigo-800 transition-colors">HuggingFace</a>, <a href="https://medium.com/@AugustinCaz" target="_blank" rel="noreferrer" class="text-indigo-600 hover:text-indigo-800 transition-colors">Medium</a>, and <a href="https://github.com/Frantz103" target="_blank" rel="noreferrer" class="text-indigo-600 hover:text-indigo-800 transition-colors">GitHub</a>.
          </p>

          <p class="text-base">
            <a href="/timeline/" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 transition-colors font-medium">
              See my full technical journey
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </p>
        </div>

        <div class="mt-10 pt-10 border-t border-neutral-100">
          <h3 class="text-sm font-bold uppercase tracking-widest text-neutral-500 mb-4">
            Focus Areas
          </h3>
          <div class="flex flex-wrap gap-3">
            {
              focusAreas.map((tag) => (
                <span class="px-4 py-2 bg-neutral-50 text-neutral-600 text-sm rounded-full border border-neutral-100 hover:border-indigo-200 transition-colors">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
