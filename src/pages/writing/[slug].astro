---
import EssayLayout from '@/layouts/EssayLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((essay) => ({
    params: { slug: essay.data.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<EssayLayout title={essay.data.title} date={essay.data.date} excerpt={essay.data.excerpt} slug={essay.data.slug}>
  <Content />
</EssayLayout>
