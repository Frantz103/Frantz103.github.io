---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResearchCard from '@/components/ResearchCard.astro';
import EssayCard from '@/components/EssayCard.astro';
import { researchInterests } from '@/data/research-interests';
import { technicalWriting } from '@/data/technical-writing';
import { getCollection } from 'astro:content';

const allEssays = await getCollection('essays');
const essays = allEssays.filter((e) => !e.data.draft);
essays.sort((a, b) => (a.data.date > b.data.date ? -1 : 1));
---

<BaseLayout
  title="Research & Writing"
  description="A curated set of micro-essays, reflections, and technical explorations on cognition and intelligent systems."
>
  <div class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
    <div class="mb-20 text-center">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-neutral-900 mb-6">
        Research & Writing
      </h2>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
        A curated set of micro-essays, reflections, and technical explorations on cognition and
        intelligent systems.
      </p>
    </div>

    <div class="mb-24">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-neutral-200 flex-grow"></div>
        <span class="text-sm uppercase tracking-widest text-neutral-500 font-bold"
          >Research Interests</span
        >
        <div class="h-px bg-neutral-200 flex-grow"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {researchInterests.map((interest) => <ResearchCard interest={interest} />)}
      </div>
    </div>

    <div class="mb-24">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-neutral-200 flex-grow"></div>
        <span class="text-sm uppercase tracking-widest text-neutral-500 font-bold"
          >Technical Writing & Analysis</span
        >
        <div class="h-px bg-neutral-200 flex-grow"></div>
      </div>

      <div class="grid grid-cols-1 gap-6 max-w-3xl mx-auto">
        {
          technicalWriting.map((entry) => (
            <div class="group p-6 bg-white border border-neutral-100 shadow-sm rounded-xl hover:shadow-md transition-all duration-300">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-grow">
                  <div class="flex items-center gap-3 mb-2">
                    <h3 class="text-base font-serif font-semibold text-neutral-800">
                      {entry.href ? (
                        <a href={entry.href} class="hover:text-indigo-600 transition-colors">
                          {entry.title}
                        </a>
                      ) : (
                        entry.title
                      )}
                    </h3>
                    {entry.status === 'forthcoming' && (
                      <span class="text-xs px-2.5 py-0.5 rounded-full border border-neutral-200 bg-neutral-50 text-neutral-400 font-medium whitespace-nowrap">
                        Forthcoming
                      </span>
                    )}
                  </div>
                  <p class={`text-sm leading-relaxed ${entry.status === 'forthcoming' ? 'text-neutral-400' : 'text-neutral-600'}`}>
                    {entry.description}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-neutral-200 flex-grow"></div>
        <span class="text-sm uppercase tracking-widest text-neutral-500 font-bold"
          >Selected Essays</span
        >
        <div class="h-px bg-neutral-200 flex-grow"></div>
      </div>

      <div class="grid grid-cols-1 gap-12 max-w-3xl mx-auto">
        {
          essays.map((essay) => (
            <EssayCard
              date={essay.data.date}
              title={essay.data.title}
              excerpt={essay.data.excerpt}
              href={`/writing/${essay.data.slug}/`}
            />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
