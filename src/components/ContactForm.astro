<form
  name="contact"
  method="POST"
  action="/contact-success/"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class="w-full bg-white/80 border border-neutral-100 rounded-2xl shadow-[0_20px_40px_-20px_rgba(0,0,0,0.2)] p-8 space-y-6"
>
  <input type="hidden" name="form-name" value="contact" />
  <div class="hidden" aria-hidden="true">
    <label>
      Don't fill this out if you're human <input name="bot-field" />
    </label>
  </div>
  <div class="hidden" aria-hidden="true">
    <label for="contact-last-name">
      Last Name
      <input id="contact-last-name" name="last-name" type="text" />
    </label>
  </div>
  <div>
    <label for="contact-name" class="block text-xs uppercase tracking-widest text-neutral-500 mb-2">
      Name
    </label>
    <input
      id="contact-name"
      name="name"
      type="text"
      required
      class="w-full bg-neutral-50 border border-neutral-100 p-3 rounded-sm focus:outline-none focus:border-indigo-500 transition-colors"
    />
  </div>
  <div>
    <label for="contact-email" class="block text-xs uppercase tracking-widest text-neutral-500 mb-2">
      Email
    </label>
    <input
      id="contact-email"
      name="email"
      type="email"
      required
      class="w-full bg-neutral-50 border border-neutral-100 p-3 rounded-sm focus:outline-none focus:border-indigo-500 transition-colors"
    />
  </div>
  <div>
    <label
      for="contact-message"
      class="block text-xs uppercase tracking-widest text-neutral-500 mb-2"
    >
      Message
    </label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      required
      class="w-full bg-neutral-50 border border-neutral-100 p-3 rounded-sm focus:outline-none focus:border-indigo-500 transition-colors"
    ></textarea>
  </div>
  <button
    type="submit"
    class="w-full px-6 py-3 text-sm tracking-[0.3em] uppercase transition-colors bg-neutral-900 text-white hover:bg-indigo-700"
  >
    Send Message
  </button>
</form>
