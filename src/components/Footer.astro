---
const year = new Date().getFullYear();
---

<footer class="bg-neutral-50 border-t border-neutral-200 py-12 mt-20">
  <div
    class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 text-sm text-neutral-500"
  >
    <div class="flex space-x-6">
      <a
        href="https://frantzphotography.com"
        class="hover:text-indigo-600 transition-colors"
        target="_blank"
        rel="noreferrer"
      >
        Photography
      </a>
      <a
        href="https://chezfrantz.com"
        class="hover:text-indigo-600 transition-colors"
        target="_blank"
        rel="noreferrer"
      >
        Chez Frantz
      </a>
      <a
        href="https://frantzstudio.com/"
        class="hover:text-indigo-600 transition-colors"
        target="_blank"
        rel="noreferrer"
      >
        Frantz Studio
      </a>
    </div>
    <p>&copy; {year} Frantz Augustin. All rights reserved.</p>
  </div>
</footer>
